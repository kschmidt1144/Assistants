{
  "name": "assistants",
  "version": "0.1.0",
  "private": true,
  "description": "Focused AI assistants (Coding, Meeting, Jobs) built on one shared core. See REBUILD_PLAN.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core-web",
    "apps/*/frontend"
