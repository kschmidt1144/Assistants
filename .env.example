# ── Secrets (copy to .env; never commit .env) ─────────────────────────────────
# Anthropic / Claude — deep reasoning (Opus 4.8 / Sonnet 4.6 / Haiku 4.5)
ANTHROPIC_API_KEY=

# Google Gemini — realtime audio/video streaming (Gemini Live)
GOOGLE_API_KEY=

# ── Model overrides (optional; defaults live in assistants_core/models.py) ─────
# Realtime = native-audio Gemini Live (decision #8). Default is below; override if your key
# has a different/newer one (e.g. gemini-3.1-flash-live-preview). Verify: client.models.list().
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# CLAUDE_DEEP_MODEL=claude-opus-4-8
# CLAUDE_BALANCED_MODEL=claude-sonnet-4-6
# CLAUDE_FAST_MODEL=claude-haiku-4-5

# ── Local persistence ─────────────────────────────────────────────────────────
# ASSISTANTS_DB_PATH=./data/assistants.sqlite
